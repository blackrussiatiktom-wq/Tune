<PlayerScreen>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: (dp(20), dp(12))
        spacing: dp(16)

        BoxLayout:
            size_hint_y: None
            height: dp(44)

            Button:
                text: "Назад"
                size_hint: (None, 1)
                width: dp(100)
                background_normal: ""
                background_color: 0.1, 0.1, 0.15, 1
                color: 1, 1, 1, 1
                on_release: root.go_back()

            Label:
                text: "Плеер"
                font_size: "22sp"
                color: 1, 1, 1, 1

        Image:
            source: "assets/icon.png"
            size_hint: (1, 0.5)

        Label:
            id: player_title
            text: "Название трека"
            font_size: "22sp"
            color: 1, 1, 1, 1
            size_hint_y: None
            height: dp(40)

        Label:
            id: player_artist
            text: "Артист"
            font_size: "15sp"
            color: 0.55, 0.55, 0.68, 1
            size_hint_y: None
            height: dp(30)

        BoxLayout:
            size_hint_y: None
            height: dp(80)
            spacing: dp(8)

            Button:
                text: "Prev"
                font_size: "18sp"
                background_normal: ""
                background_color: 0.15, 0.15, 0.2, 1
                color: 1, 1, 1, 1

            Button:
                text: "Play"
                font_size: "18sp"
                background_normal: ""
                background_color: 0.48, 0.24, 1, 1
                color: 1, 1, 1, 1
                on_release: root.toggle_play()

            Button:
                text: "Next"
                font_size: "18sp"
                background_normal: ""
                background_color: 0.15, 0.15, 0.2, 1
                color: 1, 1, 1, 1
