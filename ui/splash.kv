<SplashScreen>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(40)
        spacing: dp(20)

        Widget:

        Image:
            source: "assets/icon.png"
            size_hint: (None, None)
            size: dp(180), dp(180)
            pos_hint: {"center_x": 0.5}

        Label:
            text: "Tune"
            font_name: "Inter-Bold"
            font_size: "48sp"
            color: 1, 1, 1, 1
            size_hint_y: None
            height: dp(70)
            pos_hint: {"center_x": 0.5}
            markup: True

        Label:
            text: "Твоя музыка всегда с тобой"
            font_name: "Inter-Regular"
            font_size: "16sp"
            color: 0.55, 0.55, 0.68, 1
            size_hint_y: None
            height: dp(30)
            pos_hint: {"center_x": 0.5}

        Widget:

        # Прогресс-бар
        BoxLayout:
            size_hint: (0.6, None)
            height: dp(6)
            pos_hint: {"center_x": 0.5}

            canvas:
                Color:
                    rgba: 0.15, 0.15, 0.2, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(3)]

            Widget:
                id: progress_fill
                size_hint_x: 0.01  # будет меняться

                canvas.before:
                    Color:
                        rgba: 0.48, 0.24, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(3)]

        Label:
            text: "Загрузка..."
            font_name: "Inter-Regular"
            font_size: "14sp"
            color: 0.55, 0.55, 0.68, 1
            size_hint_y: None
            height: dp(30)
            pos_hint: {"center_x": 0.5}

        Widget:
